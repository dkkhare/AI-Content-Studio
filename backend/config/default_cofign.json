{
  "application": {
    "name": "AI Content Studio",
    "theme": "dark",
    "language": "en",
    "autosave_minutes": 5
  },

  "paths": {
    "input": "input",
    "output": "output",
    "models": "models",
    "logs": "logs",
    "temp": "temp"
  },

  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "format": "mp4"
  },

  "audio": {
    "sample_rate": 24000,
    "channels": 1
  },

  "gpu": {
    "enabled": true
  }
}